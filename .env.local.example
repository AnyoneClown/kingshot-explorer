# Full local bot settings.
DISCORD_TOKEN=your_local_discord_bot_token_here
BOT_INSTANCE=local

ADMIN_USER_ID=your_discord_user_id
# ADMIN_USER_IDS=123456789012345678,876543210987654321

COCKROACHDB_URL=cockroachdb+asyncpg://postgres:password@host:26257/database-name

KS_DATA_API_KEY=your_kingshot_data_api_key
KS_DATA_API_BASE_URL=https://ks.jeab.dev
KS_DATA_TIMEOUT_SECONDS=30
# Optional: supplies Governor IDs for uncached alliance members when Jeab's roster omits them.
# MIGHTPULSE_API_KEY=your_mightpulse_api_key
# MIGHTPULSE_API_BASE_URL=https://api.mightpulse.com

COMMAND_PREFIX=!
TRANSLATOR_ROLE=Translator
LOG_LEVEL=INFO

NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b

AUTO_REDEEM_CHANNELS=123456789012345678,876543210987654321
RANDOM_REPLY_CHANCE=0
RANDOM_REPLY_COOLDOWN_SECONDS=180
CHAT_HISTORY_LIMIT=25
MAX_CHAT_RESPONSE_CHARS=500

# Optional limits and tuning (defaults shown).
# BANNED_PLAYERS=            # Discord user IDs the bot ignores
# MAX_PLAYERS_PER_GUILD=300  # gift-code roster size per server
# MAX_SELF_REGISTERED_PLAYERS=3  # accounts a non-manager may enroll per server
# LLM_TIMEOUT_SECONDS=30
# CHAT_USER_COOLDOWN_SECONDS=10
# KINGSHOT_RAG_MAX_DISTANCE=0.7
# TRANSLATION_LOG_RETENTION_DAYS=30  # 0 keeps stored translation text forever
