logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "bots" {
  host = "unix:///var/run/docker.sock"

  filter {
    name   = "name"
    values = ["discord-translator-bot-local", "discord-translator-bot-global"]
  }
}

discovery.relabel "bots" {
  targets = discovery.docker.bots.targets

  rule {
    target_label = "app"
    replacement  = "ds-translator"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.+)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }
}

loki.source.docker "bots" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.bots.output
  forward_to = [loki.process.bot_logs.receiver]
}

loki.process "bot_logs" {
  forward_to = [loki.write.grafana_cloud.receiver]

  stage.regex {
    expression = "^(?P<log_time>\\d{2}:\\d{2}:\\d{2}) \\| (?P<level>[A-Z]) \\| (?P<bot_instance>[^|]+) \\| (?P<logger>[^|]+) \\| (?P<message>.*)$"
  }

  stage.labels {
    values = {
      level        = "",
      bot_instance = "",
      logger       = "",
    }
  }

  stage.output {
    source = "message"
  }
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_LOKI_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_LOKI_USERNAME")
      password = sys.env("GRAFANA_CLOUD_API_KEY")
    }
  }
}
