# Grafana Cloud Logs / Loki settings.
# Find these values in Grafana Cloud -> your stack -> Loki / Logs details.
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-000.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USERNAME=your_loki_username_or_instance_id

# Create a Grafana Cloud access policy token with logs:write permission.
GRAFANA_CLOUD_API_KEY=your_grafana_cloud_logs_write_token
